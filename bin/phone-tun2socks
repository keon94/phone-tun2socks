#!/usr/bin/env python3
"""Run tun2socks while preserving the normal NetworkManager default route."""
import ipaddress
import os
import signal
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlparse

import yaml

CONFIG = Path('/etc/phone-tun2socks/config.yaml')

def run(*args, check=True):
    return subprocess.run(args, check=check, text=True, capture_output=True)

def main():
    cfg = yaml.safe_load(CONFIG.read_text())
    iface, tun = cfg['interface'], cfg['tun_interface']
    proxy = cfg['proxy_url']
    parsed = urlparse(proxy)
    if parsed.scheme not in ('socks5', 'http') or not parsed.hostname or not parsed.port:
        raise ValueError('proxy_url must be socks5://host:port or http://host:port')
    ip = ipaddress.IPv4Address(parsed.hostname)
    ipaddress.IPv4Interface(cfg['tun_address'])
    for name in (iface, tun):
        if not name or not all(c.isalnum() or c in '_.-' for c in name):
            raise ValueError('Invalid interface name')
    if iface == tun:
        raise ValueError('Physical and TUN interfaces must differ')
    # Only operate while connected to the configured SSID.
    active = run('nmcli', '-g', 'GENERAL.CONNECTION', 'device', 'show', iface).stdout.strip()
    if not active or active == '--':
        raise RuntimeError('Wi-Fi interface has no active connection')
    ssid = run('nmcli', '-g', '802-11-wireless.ssid', 'connection', 'show', active).stdout.strip()
    if ssid != cfg['ssid']:
        raise RuntimeError('Configured phone SSID is not connected')
    # Phone endpoint must be reachable directly over the phone Wi-Fi.
    route = run('ip', '-4', 'route', 'get', str(ip)).stdout.split()
    if 'dev' not in route or route[route.index('dev') + 1] != iface:
        raise RuntimeError('Proxy endpoint is not routed through configured Wi-Fi interface')
    created = False
    routes = []
    child = None
    def shutdown(_sig, _frame):
        if child and child.poll() is None:
            child.terminate()
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    try:
        run('ip', 'tuntap', 'add', 'dev', tun, 'mode', 'tun')
        created = True
        run('ip', 'address', 'add', cfg['tun_address'], 'dev', tun)
        run('ip', 'link', 'set', 'dev', tun, 'up')
        # /32 protects the proxy path, even if it was previously reachable by default.
        # This deployment assumes the phone proxy is on-link (typical for TetherFi).
        run('ip', '-4', 'route', 'add', f'{ip}/32', 'dev', iface)
        routes.append((f'{ip}/32', iface))
        for cidr in ('0.0.0.0/1', '128.0.0.0/1'):
            run('ip', '-4', 'route', 'add', cidr, 'dev', tun)
            routes.append((cidr, tun))
        child = subprocess.Popen(['tun2socks', '--device', f'tun://{tun}', '--proxy', proxy, '--interface', iface])
        return child.wait()
    finally:
        if child and child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=5)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
        for cidr, dev in reversed(routes):
            run('ip', '-4', 'route', 'del', cidr, 'dev', dev, check=False)
        if created:
            run('ip', 'link', 'del', tun, check=False)

if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError, RuntimeError) as exc:
        print(f'phone-tun2socks: {exc}', file=sys.stderr)
        sys.exit(1)
