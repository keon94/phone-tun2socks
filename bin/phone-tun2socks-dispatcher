#!/usr/bin/env python3
"""NetworkManager dispatcher: start/stop only for the configured SSID."""
import subprocess
import sys
from pathlib import Path
import yaml

cfg = yaml.safe_load(Path('/etc/phone-tun2socks/config.yaml').read_text())
if len(sys.argv) < 3 or sys.argv[1] != cfg['interface'] or sys.argv[2] not in ('up', 'down'):
    sys.exit(0)
uuid = __import__('os').environ.get('CONNECTION_UUID', '')
if not uuid:
    sys.exit(0)
p = subprocess.run(['nmcli', '-g', '802-11-wireless.ssid', 'connection', 'show', 'uuid', uuid], capture_output=True, text=True)
if p.returncode or p.stdout.strip() != cfg['ssid']:
    sys.exit(0)
subprocess.run(['systemctl', '--no-block', 'start' if sys.argv[2] == 'up' else 'stop', 'phone-tun2socks.service'], check=True)
